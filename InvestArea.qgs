    <layer-tree-layer checked="Qt::Checked" expanded="1" id="karabakh_parcels" name="Qarabağ Dövlət Torpaq Fondu &amp; Məşğulluq Sahələri" providerKey="ogr" source="./public/gis/karabakh_parcels.geojson"/>
